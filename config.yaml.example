app:
  env: development
  log_level: info

http:
  host: 0.0.0.0
  port: 8080

database:
  driver: postgres
  host: localhost
  port: 5432
  name: mdrive
  user: postgres
  password: postgres
  sslmode: disable

storage:
  region: us-east-1
  endpoint: ""
  access_key: ""
  secret_key: ""
  use_path_style: false
  presign_ttl: "1h"

crypto:
  master_key: ""

valkey:
  addrs:
    - localhost:6379
  password: ""
  db: 0
  tls: false

auth:
  provider: zitadel
  issuer: "https://sso.mandacode.com"
  client_id: "123456789@mdrive"
  session_ttl: "24h"
  frontend_url: "http://localhost:3000"

openfga:
  # api_url: "http://localhost:8081"      # Set to enable permission checks
  # store_id: "01J..."                   # OpenFGA store ID (required)
  # authorization_model_id: "01J..."     # Authorization model ID
  # api_token: ""                        # OpenFGA API token (or set OPENFGA_API_TOKEN env)