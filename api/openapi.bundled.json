{
  "openapi": "3.1.0",
  "info": {
    "title": "mdrive API",
    "version": "0.1.0",
    "description": "POSIX-like file system API over S3"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Development server"
    },
    {
      "url": "https://api.mdrive.mandacode.com",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives": {
      "post": {
        "operationId": "createDrive",
        "summary": "Create a new drive",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DriveCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Drive created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Drive"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listDrives",
        "summary": "List drives owned by the authenticated user",
        "responses": {
          "200": {
            "description": "List of drives",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Drive"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/root": {
      "get": {
        "operationId": "getDrive",
        "summary": "Get a drive by ID",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Drive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Drive"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateDrive",
        "summary": "Update a drive",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DriveUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated drive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Drive"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteDrive",
        "summary": "Soft-delete a drive",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/v1/drives/{driveID}/restore": {
      "post": {
        "operationId": "restoreDrive",
        "summary": "Restore a soft-deleted drive",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Restored drive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Drive"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/drives/deleted": {
      "get": {
        "operationId": "listDeletedDrives",
        "summary": "List soft-deleted drives (admin only)",
        "responses": {
          "200": {
            "description": "List of deleted drives",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Drive"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/storage": {
      "get": {
        "operationId": "getDriveStorage",
        "summary": "Get a drive's storage configuration",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Storage config",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageConfig"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs/mkdir": {
      "post": {
        "operationId": "mkdir",
        "summary": "Create a directory (POSIX mkdir(2))",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Directory created"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs/touch": {
      "post": {
        "operationId": "touch",
        "summary": "Create an empty file (POSIX open(O_CREAT))",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File created"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs": {
      "delete": {
        "operationId": "rm",
        "summary": "Remove files or directories (POSIX unlink/rmdir(2))",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "paths"
                ],
                "properties": {
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "recursive": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs/mv": {
      "post": {
        "operationId": "mv",
        "summary": "Move files or directories (POSIX rename(2))",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sources",
                  "destination"
                ],
                "properties": {
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "destination": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Moved"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs/ls": {
      "get": {
        "operationId": "ls",
        "summary": "List directory contents (POSIX opendir/readdir)",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "default": "/"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Directory listing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirContent"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs/cat": {
      "get": {
        "operationId": "cat",
        "summary": "Read file contents (POSIX open(O_RDONLY))",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File content",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs/write": {
      "put": {
        "operationId": "write",
        "summary": "Write inline content to a file",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "path",
                  "content"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Written"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs/symlink": {
      "post": {
        "operationId": "symlink",
        "summary": "Create a symbolic link (POSIX symlink(2))",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "target",
                  "linkPath"
                ],
                "properties": {
                  "target": {
                    "type": "string"
                  },
                  "linkPath": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Symlink created"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs/hardlink": {
      "post": {
        "operationId": "hardlink",
        "summary": "Create a hard link (POSIX link(2))",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "srcPath",
                  "linkPath"
                ],
                "properties": {
                  "srcPath": {
                    "type": "string"
                  },
                  "linkPath": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hardlink created"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs/mount": {
      "post": {
        "operationId": "mount",
        "summary": "Bind-mount another drive at a path (POSIX mount-like)",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "mountPath",
                  "sourceDriveID"
                ],
                "properties": {
                  "mountPath": {
                    "type": "string"
                  },
                  "sourceDriveID": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mount created"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs/unmount": {
      "delete": {
        "operationId": "unmount",
        "summary": "Remove a bind mount (POSIX umount-like)",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mountPath",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Unmounted"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs/stat": {
      "get": {
        "operationId": "stat",
        "summary": "Get file metadata, following symlinks (POSIX stat(2))",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeStat"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs/lstat": {
      "get": {
        "operationId": "lstat",
        "summary": "Get file metadata without following symlinks (POSIX lstat(2))",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File metadata (symlink returned as-is)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeStat"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs/readlink": {
      "get": {
        "operationId": "readlink",
        "summary": "Read a symbolic link's target (POSIX readlink(2))",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Symlink target",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "target"
                  ],
                  "properties": {
                    "target": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs/realpath": {
      "get": {
        "operationId": "realpath",
        "summary": "Resolve all symlinks and return the canonical (driveID, path) pair (POSIX realpath(3))",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical path",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "driveID",
                    "path"
                  ],
                  "properties": {
                    "driveID": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/fs/object": {
      "post": {
        "operationId": "writeLarge",
        "summary": "Create an S3-backed object node",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "path",
                  "object",
                  "size"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "object": {
                    "$ref": "#/components/schemas/ObjectContent"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Object node created"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/uploads": {
      "post": {
        "operationId": "initiateUpload",
        "summary": "Initiate a presigned upload",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresignRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presigned upload URL created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresignResponse"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/uploads/{uploadId}/complete": {
      "post": {
        "operationId": "completeUpload",
        "summary": "Complete a presigned upload and create the object node",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "uploadId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadCompleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Object node created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadCompleteResponse"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drives/{driveID}/downloads": {
      "get": {
        "operationId": "presignDownload",
        "summary": "Get a presigned download URL for an object node",
        "parameters": [
          {
            "name": "driveID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Presigned download URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadResponse"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/users": {
      "get": {
        "operationId": "getUser",
        "summary": "Get current user",
        "responses": {
          "200": {
            "description": "User",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "upsertUser",
        "summary": "Upsert a user from OIDC claims",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "provider",
                  "providerID"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "provider": {
                    "type": "string"
                  },
                  "providerID": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User created or updated"
          }
        }
      }
    },
    "/auth/google": {
      "get": {
        "operationId": "googleLogin",
        "summary": "Initiate Google OAuth login (web)",
        "security": [],
        "responses": {
          "302": {
            "description": "Redirect to Zitadel with idp_id=google"
          }
        }
      }
    },
    "/auth/google/native": {
      "post": {
        "operationId": "googleNativeLogin",
        "summary": "Exchange a Google id_token for a mdrive session (mobile)",
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "idToken"
                ],
                "properties": {
                  "idToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/callback": {
      "get": {
        "operationId": "authCallback",
        "summary": "OAuth callback from Zitadel",
        "security": [],
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to frontend with session cookie set"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "authLogout",
        "summary": "Destroy the current session",
        "responses": {
          "204": {
            "description": "Session destroyed"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "authMe",
        "summary": "Get the current authenticated user",
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable error code",
            "enum": [
              "not_found",
              "conflict",
              "bad_request",
              "forbidden",
              "unauthorized",
              "internal",
              "revision_conflict"
            ]
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          }
        }
      },
      "Drive": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "publicID": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "ownerID": {
            "type": "string"
          },
          "rootNodeID": {
            "type": "string"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DriveCreate": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "storage": {
            "$ref": "#/components/schemas/StorageConfig"
          }
        }
      },
      "DriveUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "StorageConfig": {
        "type": "object",
        "required": [
          "bucket",
          "region"
        ],
        "properties": {
          "bucket": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "accessKey": {
            "type": "string"
          },
          "secretKey": {
            "type": "string"
          },
          "usePathStyle": {
            "type": "boolean"
          }
        }
      },
      "DirContent": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DirEntry"
            }
          }
        }
      },
      "DirEntry": {
        "type": "object",
        "properties": {
          "inodeID": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "ObjectContent": {
        "type": "object",
        "required": [
          "bucket",
          "key"
        ],
        "properties": {
          "bucket": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "checksum": {
            "type": "string"
          }
        }
      },
      "NodeStat": {
        "type": "object",
        "description": "POSIX stat(2) / lstat(2) result. Mode is an octal bitmask\n(chmod(2) bits | S_IFMT); ino is the inode id; the four\ntimestamps follow ext4 semantics. nlink is 0 for symlinks\nand other special nodes.\n",
        "required": [
          "type",
          "size",
          "mode",
          "nlink",
          "ino",
          "atime",
          "mtime",
          "ctime",
          "crtime"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "mode": {
            "type": "integer",
            "format": "int32",
            "description": "POSIX permission bits and file type (chmod(2) bits | S_IFMT)."
          },
          "nlink": {
            "type": "integer",
            "format": "int32",
            "description": "POSIX st_nlink (hardlink count)."
          },
          "ino": {
            "type": "string",
            "format": "uuid",
            "description": "POSIX st_ino (inode id)."
          },
          "uid": {
            "type": "string",
            "description": "POSIX st_uid (owning user)."
          },
          "gid": {
            "type": "string",
            "description": "POSIX st_gid (owning group)."
          },
          "atime": {
            "type": "string",
            "format": "date-time",
            "description": "POSIX st_atime."
          },
          "mtime": {
            "type": "string",
            "format": "date-time",
            "description": "POSIX st_mtime."
          },
          "ctime": {
            "type": "string",
            "format": "date-time",
            "description": "POSIX st_ctime (inode change time, not creation)."
          },
          "crtime": {
            "type": "string",
            "format": "date-time",
            "description": "Creation time (ext4 st_crtime)."
          },
          "flags": {
            "type": "string",
            "description": "ext4-style i_flags bitmask (hex)."
          },
          "revision": {
            "type": "string",
            "description": "Internal revision token (ULID) for optimistic concurrency."
          }
        }
      },
      "PresignRequest": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Destination path inside the drive"
          },
          "contentType": {
            "type": "string",
            "description": "MIME type of the object (optional, included in the signed URL)"
          },
          "contentLength": {
            "type": "integer",
            "format": "int64",
            "description": "Expected object size in bytes (optional)"
          }
        }
      },
      "PresignResponse": {
        "type": "object",
        "required": [
          "uploadId",
          "method",
          "url",
          "key",
          "expiresAt"
        ],
        "properties": {
          "uploadId": {
            "type": "string",
            "description": "Opaque token to pass to the complete endpoint"
          },
          "method": {
            "type": "string",
            "example": "PUT"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Presigned URL the client PUTs the bytes to"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Headers that must be included with the PUT request"
          },
          "key": {
            "type": "string",
            "description": "S3 object key that will be created"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UploadCompleteRequest": {
        "type": "object",
        "required": [
          "contentLength"
        ],
        "properties": {
          "contentLength": {
            "type": "integer",
            "format": "int64",
            "description": "Actual object size in bytes"
          },
          "checksum": {
            "type": "string",
            "description": "ETag or checksum of the uploaded object (optional)"
          }
        }
      },
      "UploadCompleteResponse": {
        "type": "object",
        "required": [
          "inodeID",
          "size"
        ],
        "properties": {
          "inodeID": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "mtime": {
            "type": "string",
            "format": "date-time"
          },
          "atime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DownloadResponse": {
        "type": "object",
        "required": [
          "method",
          "url",
          "expiresAt"
        ],
        "properties": {
          "method": {
            "type": "string",
            "example": "GET"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "publicID": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "providerID": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
