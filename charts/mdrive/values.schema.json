{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdrive chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "issuer": { "type": "string" },
            "client_id": { "type": "string" },
            "redirect_uri": { "type": "string" },
            "post_login_url": { "type": "string" },
            "post_logout_url": { "type": "string" },
            "encryption_key": { "type": "string" },
            "session_ttl": { "type": "string" },
            "frontend_url": { "type": "string" }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "encryption_key": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "auth": {
                "properties": {
                  "issuer": { "pattern": "^.+$" }
                }
              }
            }
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "config": {
                "properties": {
                  "auth": {
                    "properties": {
                      "encryption_key": { "type": "string", "minLength": 16 }
                    },
                    "required": ["encryption_key"]
                  }
                }
              }
            }
          },
          {
            "properties": {
              "secrets": {
                "properties": {
                  "auth": {
                    "properties": {
                      "encryption_key": { "type": "string", "minLength": 16 }
                    },
                    "required": ["encryption_key"]
                  }
                }
              }
            }
          },
          {
            "properties": {
              "secrets": {
                "properties": {
                  "auth": {
                    "properties": {
                      "existingSecret": { "type": "string", "minLength": 1 }
                    },
                    "required": ["existingSecret"]
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}